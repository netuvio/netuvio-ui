{
  "name": "netuvio-ui",
  "version": "0.1.0",
  "description": "UI component library for Netuvio applications",
  "author": "Netuvio",
  "license": "ISC",
  "type": "module",
  "files": [
    "dist",
    "src/tokens/scss"
  ],
  "exports": {
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs"
    },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./scss/*": "./src/tokens/scss/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.2.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/vue3": "^8.6.18",
    "@storybook/vue3-vite": "^8.6.14",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass-embedded": "^1.104.0",
    "storybook": "^8.6.14",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
