{
  "name": "@netuvio/ui",
  "version": "1.4.1",
  "description": "UI component library for Netuvio applications",
  "author": "Netuvio",
  "contributors": [
    "Stanislav Škudrna",
    "Jakub Sokol"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netuvio/netuvio-ui.git"
  },
  "bugs": {
    "url": "https://github.com/netuvio/netuvio-ui/issues"
  },
  "homepage": "https://github.com/netuvio/netuvio-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/vue/index.mjs",
  "module": "./dist/vue/index.mjs",
  "types": "./dist/vue/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.mjs"
    },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./ui.css": "./dist/ui.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "pnpm build",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.2.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/vue3": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "storybook": "^10.6.0",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
